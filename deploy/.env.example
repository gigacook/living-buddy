# Copy to deploy/.env and adjust. Never commit the real .env.
# All values below are placeholders.

TENDLY_TIMEZONE=Europe/Stockholm
TENDLY_LOG=info

# Encryption key for stored provider tokens and subscription URLs.
# Generate with `tendly gen-key` and store it in deploy/secrets/encryption.key.
TENDLY_ENCRYPTION_KEY_FILE=/run/secrets/tendly/encryption.key

# Set to false if you run the separate worker (compose profile "worker",
# the systemd timer, or cron) so only one scheduler runs.
TENDLY_EMBEDDED_WORKER=true

# Optional: bring-your-own AI key for extraction (usage is billed by your provider).
# TENDLY_AI_API_KEY_FILE=/run/secrets/tendly/ai.key

# Optional: your own OAuth apps for mailbox connectors.
# TENDLY_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# TENDLY_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/tendly/google_client_secret
# TENDLY_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# TENDLY_MICROSOFT_CLIENT_SECRET_FILE=/run/secrets/tendly/microsoft_client_secret
# TENDLY_OAUTH_REDIRECT_BASE=http://127.0.0.1:7878

# Remote mode only (internet-reachable behind HTTPS):
# TENDLY_MODE=remote
# TENDLY_ALLOWED_HOSTS=tendly.example.org
# TENDLY_ADMIN_TOKEN_FILE=/run/secrets/tendly/admin_token
